---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FieldMode, {
  type FieldModeNode,
  type FieldModeRelationship,
} from '../components/FieldMode';
import '../styles/field-mode.css';

const posts = (await getCollection('posts'))
  .filter((post) => post.data.status === 'published')
  .sort((a, b) => {
    const aDate = new Date(a.data.published_date ?? a.data.date).getTime();
    const bDate = new Date(b.data.published_date ?? b.data.date).getTime();
    const dateDifference = aDate - bDate;
    if (dateDifference !== 0) return dateDifference;

    return (b.data.published_order ?? 0) - (a.data.published_order ?? 0);
  });

const formats: Record<string, string> = {
  'a-public-journal-begins-with-a-boundary': 'Field brief',
  'what-i-mean-by-a-cognitive-workbench': 'Design record',
};

const claimOffsets = [
  { x: -300, y: -310 },
  { x: 320, y: -230 },
  { x: -280, y: 265 },
  { x: 330, y: 300 },
];

const recordNodes: FieldModeNode[] = posts.map((post, index) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description ?? '',
  href: `/posts/${post.id}`,
  kind: 'record',
  format: formats[post.id] ?? 'Journal entry',
  publishedDate: post.data.published_date ?? post.data.date,
  readingMinutes: post.data.reading_time_minutes,
  recordIndex: index,
  x: 460 + index * 980,
  y: 720,
}));

const claimNodes: FieldModeNode[] = posts.flatMap((post, postIndex) => {
  const record = recordNodes[postIndex];
  return (post.data.claim_map ?? []).map((claim, claimIndex) => {
    const offset = claimOffsets[claimIndex % claimOffsets.length];
    return {
      id: `${post.id}-claim-${claimIndex + 1}`,
      title: claim.claim,
      description: `Declared as ${claim.label.replace('-', ' ')} in this reviewed public record.`,
      href: `/posts/${post.id}`,
      kind: claim.label,
      format: formats[post.id] ?? 'Journal entry',
      publishedDate: post.data.published_date ?? post.data.date,
      source: claim.source,
      parentId: post.id,
      x: record.x + offset.x,
      y: record.y + offset.y,
    };
  });
});

const nodes = [...recordNodes, ...claimNodes];
const relationships: FieldModeRelationship[] = claimNodes.map((claim) => ({
  id: `C-${claim.id}`,
  from: claim.parentId ?? '',
  to: claim.id,
  label: `${claim.kind.replace('-', ' ')} recorded`,
  note: claim.source ?? 'Declared public record context.',
  kind: 'claim',
}));

if (
  recordNodes.some((node) => node.id === 'a-public-journal-begins-with-a-boundary')
  && recordNodes.some((node) => node.id === 'what-i-mean-by-a-cognitive-workbench')
) {
  relationships.push({
    id: 'R-01',
    from: 'a-public-journal-begins-with-a-boundary',
    to: 'what-i-mean-by-a-cognitive-workbench',
    label: 'Boundary → workbench',
    note: 'The opening entry establishes the public/private boundary that governs the working definition in the second entry.',
    kind: 'declared',
  });
}

function displayDate(date: string) {
  return new Date(`${date}T00:00:00`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<Base immersive>
  <FieldMode client:load nodes={nodes} relationships={relationships} />

    <noscript>
      <section class="field-fallback" aria-labelledby="field-fallback-title">
        <p>Chronological fallback</p>
        <h2 id="field-fallback-title">Published reading path</h2>
        <ol>
          {posts.map((post) => (
            <li>
              <p>{formats[post.id] ?? 'Journal entry'} · {displayDate(post.data.published_date ?? post.data.date)}</p>
              <a href={`/posts/${post.id}`}>{post.data.title}</a>
              {post.data.description && <span>{post.data.description}</span>}
            </li>
          ))}
        </ol>
      </section>
    </noscript>
</Base>

<style>
  .field-fallback {
    max-width: var(--max-width-site);
    margin: var(--space-xl) auto;
    padding: var(--space-xl);
    border: var(--border-thin);
    background: var(--color-surface);
  }
  .field-fallback h2 {
    max-width: 16ch;
    margin: 0 0 var(--space-md);
  }

  .field-fallback ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .field-fallback li {
    padding: var(--space-md) 0;
    border-top: var(--border-thin);
  }

  .field-fallback p,
  .field-fallback span {
    display: block;
    margin: 0 0 var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }

  @media (max-width: 700px) {
    .field-fallback {
      padding: var(--space-lg);
    }
  }
</style>
