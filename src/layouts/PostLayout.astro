---
import Base from './Base.astro';
import ArticleGuide from '../components/ArticleGuide.astro';
import { ReadingModeProvider } from '../components/ReadingMode';
import SourceTrail from '../components/SourceTrail.astro';
import '../styles/post-reading-grammar.css';
import '../styles/reading-mode.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  date: string;
  description: string;
  tags: string[];
  sources: string[];
  headings: Heading[];
  featuredImage?: string;
  featuredImageAlt?: string;
  readingTimeMinutes?: number;
  isLocalReview?: boolean;
}

const {
  title,
  date,
  description,
  tags = [],
  sources = [],
  headings = [],
  featuredImage,
  featuredImageAlt,
  readingTimeMinutes,
  isLocalReview = false,
} = Astro.props;

const displayDate = new Date(date + 'T00:00:00');
---

<Base>
  <ReadingModeProvider client:visible>
    <article class="post">
      <header class="post-header">
        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>
        <dl class="post-meta">
          <div class="post-meta-group">
            <dt class="sr-only">Date</dt>
            <dd>
              <time datetime={date}>
                {displayDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            </dd>
          </div>
          {readingTimeMinutes && (
            <div class="post-meta-group">
              <dt class="sr-only">Reading time</dt>
              <dd>{readingTimeMinutes} min read</dd>
            </div>
          )}
        </dl>
      </header>

      {isLocalReview && (
        <p class="post-preview-notice" role="status">
          Local visual review only. This draft is excluded from production builds and has not
          been published.
        </p>
      )}

      <ArticleGuide headings={headings} />

      {featuredImage && (
        <figure class="post-hero">
          <img
            src={featuredImage}
            alt={featuredImageAlt ?? ''}
            width="1024"
            height="576"
            loading="eager"
          />
        </figure>
      )}

      <div class="post-body prose reading-mode">
        <slot />
      </div>

      {tags.length > 0 && (
        <footer class="post-tags-footer">
          <ul class="post-tags" aria-label="Tags">
            {tags.map((tag: string) => (
              <li class="post-tag">{tag}</li>
            ))}
          </ul>
        </footer>
      )}

      <SourceTrail sources={sources} />

      <nav class="post-nav" aria-label="Journal return routes">
        <a href="/">← field journal index</a>
        <a href="/field/">open the Field Map →</a>
        <a href="/rss.xml">follow by RSS ↗</a>
      </nav>
    </article>
  </ReadingModeProvider>
</Base>

<style>
  .post {
    max-width: var(--max-width-prose);
  }

  .post-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-lg);
    border-bottom: var(--border-thin);
  }

  .post-title {
    margin-bottom: var(--space-sm);
  }

  .post-description {
    font-size: var(--fs-md);
    color: var(--color-text-muted);
    line-height: var(--lh-relaxed);
    margin-bottom: var(--space-md);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-text-faint);
  }

  .post-meta-group {
    display: flex;
    gap: var(--space-2xs);
    align-items: baseline;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .post-hero {
    margin: 0;
    overflow: hidden;
    border: var(--border-thin);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .post-hero img {
    display: block;
    width: 100%;
    border-radius: 0;
  }

  .post-body {
    margin-top: var(--space-xl);
    font-size: var(--rm-font-size, 1rem);
    line-height: var(--rm-line-height, 1.65);
  }

  .post-body > :global(h2) {
    font-size: var(--fs-lg);
    color: var(--color-cream);
  }

  .post-body > :global(h3) {
    font-size: var(--fs-md);
    color: var(--color-text);
  }

  .post-tags-footer {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: var(--border-thin);
  }

  .post-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding: 0;
  }

  .post-tag {
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
    background: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.4em;
  }

  .post-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--border-thin);
    font-size: var(--fs-sm);
  }

  .post-nav a {
    border-bottom: none;
    color: var(--color-plasma);
    font-family: var(--font-mono);
  }
</style>
