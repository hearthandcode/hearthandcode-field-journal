---
import '../styles/global.css';

interface Props {
  immersive?: boolean;
}

const { immersive = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Hearth &amp; Code Field Journal, a public research desk log for the Exocore project, Applied AI, and the craft of building scaffolding for neurodivergent learners." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Hearth &amp; Code · Field Journal" href="/rss.xml" />
    <title>Hearth &amp; Code · Field Journal</title>
  </head>
  <body class:list={{ 'is-immersive': immersive }}>
    <header class:list={['site-header', { 'site-header-immersive': immersive }]}>
      <nav class="site-routes" aria-label="Hearth & Code and Field Journal routes">
        <a href="https://hearthandcode.dev/" class="site-parent-link">hearthandcode.dev <span aria-hidden="true">↗</span></a>
        <a href="/" class="site-title"><span class="caret" aria-hidden="true">█</span>field-journal</a>
      </nav>
      <span class="site-tagline">a public research desk log</span>
    </header>
    <main class:list={{ 'main-immersive': immersive }}>
      <slot />
    </main>
    <footer class:list={['site-footer', { 'site-footer-immersive': immersive }]}>
      <span>Field Journal · <a href="https://hearthandcode.dev/">Hearth &amp; Code home ↗</a> · <a href="/rss.xml">RSS</a> · <a href="https://github.com/hearthandcode/hearthandcode-field-journal">source</a></span>
      <span class="footer-note">experimental · no claims · no telemetry</span>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-xl) var(--space-md);
    max-width: var(--max-width-site);
    margin: 0 auto;
    border-bottom: var(--border-thin);
  }

  .site-routes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .site-parent-link,
  .site-title {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    border-bottom: none;
    letter-spacing: 0.02em;
  }

  .site-parent-link {
    color: var(--color-text-muted);
  }

  .site-title {
    color: var(--color-text);
  }

  .caret {
    display: inline-block;
    width: 0.65ch;
    margin-right: 0.25em;
    color: var(--color-ember);
    line-height: 1;
    animation: cursor-blink 1.2s steps(1, end) infinite;
  }

  @keyframes cursor-blink {
    0%, 45% { opacity: 1; }
    46%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }

  .site-parent-link:hover,
  .site-parent-link:focus-visible,
  .site-title:hover,
  .site-title:focus-visible {
    color: var(--color-cream);
  }

  .site-tagline {
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
    margin-top: var(--space-2xs);
  }

  .site-header-immersive {
    max-width: none;
    padding: var(--space-sm) max(var(--space-lg), calc((100vw - var(--max-width-site)) / 2));
  }

  .site-header-immersive .site-tagline {
    display: none;
  }

  main {
    max-width: var(--max-width-site);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
  }

  .main-immersive {
    max-width: none;
    padding: 0;
  }

  .site-footer {
    max-width: var(--max-width-site);
    margin: var(--space-2xl) auto 0;
    padding: var(--space-lg) var(--space-md);
    border-top: var(--border-thin);
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .site-footer a {
    color: var(--color-text-muted);
    border-bottom-color: var(--color-text-faint);
  }

  .site-footer a:hover {
    color: var(--color-cream);
  }

  .site-footer-immersive {
    max-width: none;
    margin-top: 0;
    padding-right: max(var(--space-lg), calc((100vw - var(--max-width-site)) / 2));
    padding-left: max(var(--space-lg), calc((100vw - var(--max-width-site)) / 2));
  }

  @media (max-width: 600px) {
    .site-footer {
      flex-direction: column;
    }
  }
</style>
